# Postgres - Railway inyecta esta variable automaticamente al conectar el plugin de Postgres
DATABASE_URL=postgres://user:password@host:5432/dbname

# Cloudinary (cuenta central compartida por todos los clientes)
CLOUDINARY_CLOUD_NAME=tu-cloud-name
CLOUDINARY_API_KEY=tu-api-key
CLOUDINARY_API_SECRET=tu-api-secret

# Resend (correo transaccional)
RESEND_API_KEY=re_xxxxxxxxxxxxx
RESEND_FROM_EMAIL="FieldProof <notificaciones@tudominio.com>"

# Super-admin de la plataforma
PLATFORM_ADMIN_PASSWORD=cambia-esto-por-una-clave-fuerte

# Firma de sesion para el panel de super-admin (cualquier cadena aleatoria larga)
SESSION_SECRET=cambia-esto-tambien

# Puerto (Railway lo inyecta automaticamente, no es necesario definirlo en produccion)
PORT=3000

# URL publica de la app (usada en los correos de aviso)
PUBLIC_APP_URL=https://tuapp.up.railway.app
